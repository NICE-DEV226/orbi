# ─────────────────────────────────────────────
# Orbi — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# ─────────────────────────────────────────────

# ── Environnement ──
ENVIRONMENT=development
BASE_URL=http://localhost:8000

# ── Telegram ──
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret
ADMIN_CHAT_ID=0

# ── MongoDB ──
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=orbi_dev

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── Secret applicatif (jetons CSRF du dashboard ; 32 caractères minimum en production) ──
JWT_SECRET=change-me-to-a-long-random-string

# ── Tokens API Bearer (vide = routes /api/v1/* refusées) ──
ADMIN_API_TOKEN=
DEV_API_TOKEN=
METRICS_API_TOKEN=

# ── Orbi Dev : clé(s) Fernet pour chiffrer les secrets d'intégration ──
# Générer : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Plusieurs clés séparées par des virgules = rotation (la première chiffre)
SECRETS_ENCRYPTION_KEY=
# Intervalle (secondes) du suivi des exécutions Orbi Dev ; 0 = désactivé
ORBI_DEV_REFRESH_INTERVAL=30

# ── GitHub ──
GITHUB_WEBHOOK_SECRET=

# ── Modules optionnels ──
# Communauté (sondages, karma, modération de groupes). Désactivée par défaut : la modération lit le texte
# de tous les messages des groupes où le bot est présent.
ENABLE_COMMUNITY=false

# ── Logging ──
LOG_LEVEL=INFO

# ── Docker Compose ──
# Adresse d'écoute du port 8000 (127.0.0.1 = derrière un reverse proxy HTTPS)
BIND_ADDR=127.0.0.1
